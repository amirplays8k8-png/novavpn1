{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "novavpn1",
  "main": "worker.js",
  "compatibility_date": "2026-07-30",
  "compatibility_flags": ["nodejs_compat"],
  "d1_databases": [
    { "binding": "DB","database_id": "ebb6c9f6-adaf-46b6-abb4-b9c0207162f1","database_name": "Novavpn1" }
  ],
  "kv_namespaces": [
    { "binding": "KV","id": "263907b4207044acb54c2d645fd3652c" }
  ],
  "workers_dev": true,
  "preview_urls": true,
  "observability": {
    "enabled": true,
    "logs": {
      "enabled": true,
      "head_sampling_rate": 1,
      "invocation_logs": true
    },
    "traces": {
      "enabled": true,
      "head_sampling_rate": 0.01
    }
  }
}
